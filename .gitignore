# 安全性與環境變數
.env
.env.local
.env.*.local
*.secret
keys/

# Python / Node 暫存
__pycache__/
node_modules/
*.pyc

# 作業系統暫存
.DS_Store
Thumbs.db

# 備份檔案
*.bak
backup/

# AI Agents & IDE 快取 (避免混淆與被追蹤)
.gemini/
.cursor/
.windsurf/

# .agents/ 的 cache 排除，但 workflows/skills 需同步
.agents/.cache/
.agents/sessions/

# .claude/ 的本機設定排除，但 skills 需同步
.claude/settings.local.json
.claude/settings.local.json.tmp.*
.claude/scheduled_tasks.lock
.claude/todos/
.claude/worktrees/

# 根目錄暫存檔
temp_*.txt
temp_*.py
recent_files.txt

# 大型二進位檔（不推上 GitHub）
ffmpeg-7.0.2-amd64-static/
media/
apps/
bin/
avatars/

# Dropbox 防污染：巢狀同名資料夾
*/*/.dropbox
*/*/.dropbox.cache

# Local Obsidian UI state
obsidian-vault/.obsidian/graph.json
obsidian-vault/.obsidian/workspace.json

# Local paper-researcher execution log
skills/paper-researcher/fetch_log.txt

# Independent nested project
saas_sandbox/blank-page-launch-lovable/
