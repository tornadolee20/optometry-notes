# 安全性與環境變數
.env
.env.local
.env.*.local
*.secret
keys/

# Google OAuth2 憑證（絕對不能推上去）
credentials.json
token.json

# Python / Node 暫存
__pycache__/
node_modules/
*.pyc

# 作業系統暫存
.DS_Store
Thumbs.db

# 備份檔案
*.bak
backup/

# AI Agents & IDE 快取 (避免混淆與被追蹤)
.gemini/
.cursor/
.windsurf/

# .agents/ 的 cache 排除，但 workflows/skills 需同步
.agents/.cache/
.agents/sessions/

# .claude/ 的本機設定排除，但 skills 需同步
.claude/settings.local.json
.claude/settings.local.json.tmp.*
.claude/scheduled_tasks.lock
.claude/todos/
.claude/worktrees/

# 根目錄暫存檔
temp_*.txt
temp_*.py
recent_files.txt
tmp/

# 大型二進位檔（不推上 GitHub）
ffmpeg-7.0.2-amd64-static/
ffmpeg.tar.xz
media/
apps/
bin/
avatars/

# 大型非視光專案目錄（不應被 AI 索引）
saas_sandbox/
AI之眼/
projects/

# Dropbox 防污染：巢狀同名資料夾
*/*/.dropbox
*/*/.dropbox.cache

# Local moved archives
AI����__moved_backup_20260517/
*__moved_backup_*/

