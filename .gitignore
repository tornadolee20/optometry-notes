# 安全性與環境變數
.env
.env.local
.env.*.local
*.secret
keys/

# Python / Node 暫存
__pycache__/
node_modules/
*.pyc

# 作業系統暫存
.DS_Store
Thumbs.db

# 備份檔案
*.bak
backup/

